{
  "name": "tq-forge",
  "version": "1.1.0",
  "description": "An autonomous skill + agent factory for Claude Code. Forge, score, and promote slash-command skills and agents from a one-line intent.",
  "bin": {
    "tq-forge": "bin/cli.js"
  },
  "type": "commonjs",
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "python3 scripts/test-runner.py && python3 -m unittest discover -s tests"
  },
  "keywords": [
    "claude-code",
    "claude-fable-5-2",
    "token-optimizer",
    "anthropic",
    "ai-agents",
    "claude-skills",
    "subagents",
    "mcp",
    "cli"
  ],
  "author": "tanishq286",
  "license": "MIT",
  "homepage": "https://github.com/tanishq286/tq-forge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanishq286/tq-forge.git"
  },
  "bugs": {
    "url": "https://github.com/tanishq286/tq-forge/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
